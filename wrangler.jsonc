{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tools",
  "main": "src/entry.py",
  // Today's date: pulls in every runtime behavior that has become default by
  // now, including Python 3.14 for Python Workers (python_workers_314 is the
  // default as of 2026-09-08). The `python_workers` base flag is required.
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Unknown paths fall back to public/404.html when the Worker forwards them
    // to the ASSETS binding.
    "not_found_handling": "404-page",
    // Dynamic routes always invoke the Python Worker, even if a static file
    // with the same path ever shows up in public/.
    "run_worker_first": ["/api/*", "/ip", "/ip.json"]
  },
  "observability": {
    "enabled": true
  },
  // Custom domains on the nbergeron.dev zone (already on this Cloudflare
  // account, so DNS is automatic). Deployed with the account's API token.
  // ip.nbergeron.dev is a dedicated, curl-friendly host for the IP endpoints.
  "routes": [
    {
      "pattern": "tools.nbergeron.dev",
      "custom_domain": true
    },
    {
      "pattern": "ip.nbergeron.dev",
      "custom_domain": true
    }
  ]
}
